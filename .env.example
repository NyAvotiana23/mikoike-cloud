# Copier vers .env (ignoré par git) puis adapter. Ne jamais commiter .env.

# --- PostgreSQL ---
POSTGRES_DB=projet_cloud
POSTGRES_USER=postgres
# Obligatoire : choisir un mot de passe
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Backend Spring Boot ---
BACKEND_PORT=8002
# Clé exigée par POST /api/admin/register. Vide = création d'admin désactivée.
ADMIN_SECRET_KEY=
LOG_LEVEL=INFO
SWAGGER_ENABLED=true

# --- Firebase (optionnel) ---
FIREBASE_ENABLED=false
# Si activé : déposer le JSON de compte de service dans ./secrets/firebase-service-account.json

# --- Frontends ---
VITE_API_URL=http://localhost:8002
